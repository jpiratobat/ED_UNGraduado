drop table if exists prerrequisitos;
drop table if exists materias;

create table materias (
    id integer primary key,
    codigo integer not null unique,
    nombre text not null,
    creditos integer not null,
    semestre integer not null,
    estado text not null default 'pendiente'
        check (estado in ('vista', 'en_curso', 'pendiente'))
);

create table prerrequisitos (
    materias_id integer not null,
    requiere_id integer not null,
    primary key (materias_id, requiere_id),
    foreign key (materias_id) references materias(id),
    foreign key (requiere_id) references materias(id)
);

